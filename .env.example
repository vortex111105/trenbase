# ─── TRENDBASE — Variables de Entorno ───────────────────────────────────────
# Copiá este archivo a .env para desarrollo local
# En producción, configurar en Vercel → Project Settings → Environment Variables

# ── CRÍTICO (sin esto no funciona nada) ──────────────────────────────────────

# Anthropic Claude — para el chat IA y generación de productos
ANTHROPIC_API_KEY=sk-ant-...

# Supabase — base de datos y autenticación
SUPABASE_URL=https://rbrundkswmlbgkicdnty.supabase.co
SUPABASE_SERVICE_KEY=eyJ...     # service_role key (Admin)
SUPABASE_ANON_KEY=eyJ...        # anon/public key

# Seguridad del cron job
CRON_SECRET=una-contraseña-larga-y-random

# Tu dominio (sin barra final)
ALLOWED_ORIGIN=https://trendbase.app

# ── PAGOS ────────────────────────────────────────────────────────────────────

# LemonSqueezy — para cobrar suscripciones
LEMONSQUEEZY_API_KEY=...

# ── EMAIL SEMANAL ────────────────────────────────────────────────────────────

# Resend.com — para el email digest de los lunes
RESEND_API_KEY=re_...
DIGEST_FROM_EMAIL=TrendBase <alertas@trendbase.app>
ADMIN_EMAIL=ifraga.ok@gmail.com

# ── PROVEEDORES (opcional pero recomendado) ───────────────────────────────────

# AliExpress Affiliate API — precios reales en el modal de producto
AE_APP_KEY=...
AE_APP_SECRET=...
AE_TRACKING_ID=trendbase

# ── WORKER PYTHON (solo en Render.com, no en Vercel) ─────────────────────────

# Apify — scraping de TikTok Ads
APIFY_API_TOKEN=apify_api_...
APIFY_ACTOR_ID=...

# URL de tu proyecto en Vercel (para que worker.py llame a /api/generate)
VERCEL_URL=https://trendbase.vercel.app
